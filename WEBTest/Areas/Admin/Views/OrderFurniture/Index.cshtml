@model List<OrderFurnitureViewModel>
@{
    ViewData["Title"] = "Заказы фурнитуры";
}

<div class="row mt-3">
    @await Html.PartialAsync("SideBar")
    <div class="col-9 mb-3">
        <div class="text-center text-uppercase text-success mb-5 mt-5">
            <h2 class="row-title">Заказы Фурнитуры2</h2>
        </div>

        @if (Model != null && Model.Count > 0)
        {

            <div class="text-end">
                <a class="btn btn-outline-success mb-2 mt-2"
                   asp-area="Admin"
                   asp-controller="OrderFurniture"
                   asp-action="Add">
                    Заказать фурнитуру
                </a>
            </div>

            <div class="row justify-content-center mt-3">
                <div class="col-12">
                    <table class="table table-responsive table-striped table-hover mb-5">
                        <thead>
                            <tr align="center">
                                <th scope="col">#</th>
                                <th scope="col">Фурнитура</th>
                                <th scope="col">Цена</th>
                                <th scope="col">Где заказано</th>
                                <th scope="col">Заказано</th>
                                <th scope="col">Получено</th>
                                <th scope="col">Примечание</th>
                                <th scope="col">Производитель</th>
                                <th scope="col">Объем</th>

                                <th scope="col"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Count; i++)
                            {
                                <tr align="center" class="align-baseline">
                                    <td>@Model[i].Id</td>
                                    <td>@Model[i].Furnitures?.Name</td>
                                    <td>@Model[i].Price</td>
                                    <td>@Model[i].OrderPlace</td>
                                    <td>@Model[i].OrderCreationDateTime.ToShortDateString()</td>
                                    <td>@Model[i].OrderDeliveryDateTime.ToShortDateString()</td>
                                    <td>@Model[i].Description</td>
                                    <td>@Model[i].Provider</td>
                                    <td>@Model[i].Volume</td>
                                 @*    <td>@Model[i].FurnituresId</td> *@
                                    
                                </tr>
                            }
                        </tbody>

                        <tfoot>
                            <tr align="center">
                                <th colspan="4"></th>
                                <th colspan="3">
                                    Общее количество заказов: @Model.Count
                                </th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="text-center">
                <h2 class="row-title">В хранилище нет заказов!</h2>
            </div>
        }

    </div>
</div>

