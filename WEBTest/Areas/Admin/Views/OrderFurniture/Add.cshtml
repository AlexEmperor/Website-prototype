@model OrderFurnitureViewModel
@{
    ViewData["Title"] = "Заказать фурнитуру";
}

<div class="text-center text-uppercase text-success mb-5 mt-5">
    <h2 class="row-title">Заказы фурнитуры</h2>
</div>

<form method="post" enctype="multipart/form-data">
    <div class="row justify-content-center mt-3">
        <div class="col-6 mb-3">

            <div class="text-danger fw-bold text-uppercase" asp-validation-summary="All"></div>

            <p>
                <label>Заказ фурнитуры</label>
                <select class="form-control"
                        asp-for="FurnituresId"
                        asp-items="ViewBag.Furniture">
                    <option value="">Выберите заказ</option>
                </select>
            </p>

            <p>
                <label class="form-label" asp-for="OrderCreationDateTime"></label>
                <br />
                <input class="form-control" asp-for="OrderCreationDateTime" />
                <span asp-validation-for="OrderCreationDateTime"></span>
            </p>
@*             <p>
                <label class="form-label" asp-for="OrderCreationDateTime.Date"></label>
                <br />
                <input class="form-control" asp-for="OrderCreationDateTime.Date" />
                <span asp-validation-for="OrderCreationDateTime.Date"></span>
            </p> *@

            <p>
                <label>Цена</label><br />
                <textarea class="form-control" asp-for="Price"></textarea>
                <span asp-validation-for="Price"></span>
            </p>
            <p>
                <label>Место заказа</label><br />
                <textarea class="form-control" asp-for="OrderPlace"></textarea>
                <span asp-validation-for="OrderPlace"></span>
            </p>
            <p>
                <label>Описание</label><br />
                <textarea class="form-control" asp-for="Description"></textarea>
                <span asp-validation-for="Description"></span>
            </p>
            <p>
                <label>Кол-во в заказе</label><br />
                <textarea class="form-control" asp-for="Volume"></textarea>
                <span asp-validation-for="Volume"></span>
            </p>
            <p>
                <label>Произвоитель</label><br />
                    <textarea class="form-control" asp-for="Provider"></textarea>
                    <span asp-validation-for="Provider"></span>
            </p>

        </div>
    </div>

    <div class="text-center m-3">
        <button class="btn btn-outline-success" type="submit">
            Добавить
        </button>
    </div>
</form>