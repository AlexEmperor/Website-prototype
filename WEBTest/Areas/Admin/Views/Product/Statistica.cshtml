@model List<ProductViewModel>
@{
    ViewData["Title"] = "Товары Статистика";
}
@await Html.PartialAsync("SideBar")
<div class="row mt-3">




    <div class="col-9 mb-3">
        <div class="text-center text-uppercase text-success mb-5 mt-5">
            <h2 class="row-title">Товары Статистика</h2>
        </div>

        @if (Model != null && Model.Count > 0 )
        {
           
            <div class="row justify-content-center mt-3">
                <div class="col-12">
                    <table class="table table-responsive table-striped table-hover mb-5">
                        <thead>
                            <tr align="center">
                                <th scope="col">#</th>
                                <th scope="col">Артикул</th>
                                <th scope="col">Категория</th>
                                <th scope="col">Наименование товара</th>
                                <th scope="col">OZON, кол-во.</th>
                                <th scope="col">FBS1, кол-во.</th>
                                <th scope="col">Заказано</th>
                                <th scope="col">Отменено</th>
                                <th scope="col">%</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Count; i++)
                            {
                                @if ((@Model[i].Wasordered != null) & ( @Model[i].Wasordered != 0))
                                {
                                    <tr align="center" class="align-baseline">
                                        <td class="fw-bold">@Model[i].Id</td>
                                        <td style ="white-space: nowrap;">@Model[i].Article</td>
                                        <td>@Model[i].Category?.CategoryName</td>
                                        <td>@Model[i].Name</td>
                                        <td>@Model[i].Storage_Ozon</td>
                                        <td>@Model[i].Storage_FBS1</td>
                                        <td>@Model[i].Wasordered</td>
                                        <td>@Model[i].Cancelled</td>
                                        <td>
                                        @{
                                            var total = Model[i].Cancelled + Model[i].Wasordered;
                                                var percent = ( ((decimal)Model[i].Wasordered - (decimal)Model[i].Cancelled) / total) * 100;
                                        }
                                        @($"{percent:F0}%")
                                       
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot>
                            <tr align="center">
                                <th colspan="2"></th>
                                <th colspan="3">
                                    Общее количество товаров: @Model.Count
                                </th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="text-center">
                <h2 class="row-title">В хранилище нет товаров!</h2>
            </div>

            <div class="text-center mt-5">
                <a class="btn btn-outline-success mb-2 mt-2"
                   asp-area="Admin"
                   asp-controller="Product"
                   asp-action="Add">
                    Добавить новый продукт
                </a>
            </div>
        }
    </div>
</div>