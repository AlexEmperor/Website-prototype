@model FurnitureViewModel
@{
    ViewData["Title"] = "Добавление фурнитуру";
}

<div class="text-center text-uppercase text-success mb-5 mt-5">
    <h2 class="row-title">Добавление Фурнитуры</h2>
</div>

<form method="post" enctype="multipart/form-data">
    <div class="row justify-content-center mt-3">
        <div class="col-6 mb-3">
            <div class="text-danger fw-bold text-uppercase" asp-validation-summary="All"></div>
@*             <p>
                <label>ID</label><br />
                <textarea class="form-control" asp-for="Id"></textarea>
                <span asp-validation-for="Id"></span>
            </p> 
 *@

            <p>
                <label>Номер фурнитуры</label><br />
                <textarea class="form-control" asp-for="HardNumber"></textarea>
                <span asp-validation-for="HardNumber"></span>
            </p>
            <p>
                <label>Наименование</label><br />
                <textarea class="form-control" asp-for="Name"></textarea>
                <span asp-validation-for="Name"></span>
            </p>
            <p>
                <label>Описание</label><br />
                <textarea class="form-control" asp-for="Description"></textarea>
                <span asp-validation-for="Description"></span>
            </p>
            <p>
                <label>Где заказано</label><br />
                <textarea class="form-control" asp-for="OrderPlace"></textarea>
                <span asp-validation-for="OrderPlace"></span>
            </p>
            <p>
                <label>Последняя цена</label><br />
                <textarea class="form-control" asp-for="Price"></textarea>
                <span asp-validation-for="Price"></span>
            </p>
            <p>
                <label>Кол-во в заказе</label><br />
                <textarea class="form-control" asp-for="Quantity"></textarea>
                <span asp-validation-for="Quantity"></span>
            </p>

        </div>
    </div>

    <div class="text-center m-3">
        <button class="btn btn-outline-success" type="submit">
            Добавить
        </button>
    </div>
</form>