@model List<ProductViewModel>
@{
    ViewData["Title"] = "Категория Стройка";
}

<div class="text-center text-uppercase text-success mb-5 mt-5">
    <h2 class="row-title">Стройка</h2>
</div>

<div class="row mt-3">

@if (Model != null && Model.Count > 0)
{
    @foreach (var product in Model)
    {
        if (product?.Category?.CategoryName == "Стройка")
        {
                <div class="col-12 col-sm-6 col-md-6 col-lg-3 mb-4">
                    <div class="card shadow" style="height: 350px;">

                        <div class="product-image position-relative" style="display: inline-block;">
                            <center>
                                <a asp-controller="Product"
                                   asp-action="Index"
                                   asp-route-id="@product.Id"
                                   class="product-link">

                                    <img src="data:image/jpeg;base64,@Convert.ToBase64String(product.Jpeg)"
                                         alt="Product Image"
                                         class="img-fluid"
                                         style="width: 180px; height: 180px; object-fit: cover;" />
                                </a>
                            </center>

                    <div class="card-body text-center">
                        <a class="text-success"
                           asp-controller="Product"
                           asp-action="Index"
                           asp-route-id="@product.Id">
                            <h5>@product.Name</h5>
                        </a>
                        <h2 class="text-danger">@product.Cost.ToString("c0")</h2>
                        <a class="btn btn-success"
                           asp-controller="Cart"
                           asp-action="Add"
                           asp-route-productId="@product.Id">
                            Добавить в корзину
                        </a>
                        <a class="btn btn-outline-secondary mt-3"
                           asp-controller="Favourite"
                           asp-action="Add"
                           asp-route-productId="@product.Id">
                            Добавить в избранное
                        </a>
                    </div>
                </div>
            </div>
                </div>
        }
    }
}
else
{
    <div class="text-center">
        <h2>Нет товаров для отображения!</h2>
    </div>
}
</div>