
<header class="navbar sticky-top shadow p-2" data-bs-theme="dark">
    
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark border-bottom box-shadow mb-3">
        <div class="container-fluid">

            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Натали</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>


            <div class="dropdown me-2">
                <button class="btn btn-dark dropdown-toggle text-white" type="button" id="menuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-list"></i> Меню
                </button>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="menuDropdown">
                    <li><a class="dropdown-item" asp-area="" asp-controller="Contacts" asp-action="Index">О нас</a></li>
                </ul>
            </div>


            <!--Корзина-->
            
            <a class="dropdown-item d-flex align-items-center py-2"
                @await Component.InvokeAsync("Cart")
            </a>
            <!--END--Корзина-->

            <!--Избранное -->
            <a class="dropdown-item d-flex align-items-center py-2"
               asp-area=""
               asp-controller="Favourite"
               asp-action="Index"
               aria-label="Избранное">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="28"
                     height="28"
                     fill="currentColor"
                     class="bi bi-cart-fill me-2 text-primary transition"
                     viewBox="0 0 20 20"
                     style="transition: transform 0.2s ease;">
                    <path fill="currentColor" d="M3 10.163C3 7.262 5.13 5 8 5c1.929 0 3.244 1.102 4 2.066C12.756 6.102 14.071 5 16 5c2.87 0 5 2.264 5 5.163 0 4.561-4.568 7.856-8.243 9.66a1.71 1.71 0 0 1-1.514 0C7.568 18.02 3 14.724 3 10.163"></path>

                </svg>
                @* <span class="fw-medium">Избранное</span> *@
            </a>
            <!--END--Избранное-->


            <!--Мои заказы-->
            <a class="dropdown-item d-flex align-items-center py-2"
               asp-area=""
               asp-controller="MyOrder"
               asp-action="MyOrderVie"
               asp-route-category="myordervie"
               aria-label="Мои заказы">

                <svg xmlns="http://www.w3.org/2000/svg"
                     width="28"
                     height="28"
                     fill="currentColor"
                     class="bi bi-cart-fill me-2 text-primary transition"
                     viewBox="0 0 20 20"
                     style="transition: transform 0.2s ease;">
                    <path fill="currentColor" d="M14.692 5.694c.368-.205.365-.469-.009-.664C13.367 4.343 12.708 4 12 4s-1.367.343-2.683 1.03l-2 1.044c-1.614.842-2.42 1.263-2.869 2.02C4 8.85 4 9.79 4 11.673v1.652c0 1.883 0 2.824.448 3.58s1.255 1.178 2.869 2.02l2 1.044C10.633 20.657 11.292 21 12 21s1.367-.343 2.683-1.03l2-1.044c1.614-.842 2.42-1.263 2.869-2.02.448-.756.448-1.697.448-3.58v-1.652c0-1.883 0-2.824-.448-3.58-.329-.556-.851-.93-1.744-1.423-.367-.203-.389-.204-.763.004L11 10c-.344.19-.739.394-.91.77-.09.197-.09.375-.09.73V14a1 1 0 0 1-2 0v-4a1 1 0 0 1 .514-.874z"></path>
                </svg>

@*                 <span class="fw-medium">Мои заказы</span> *@
                
            </a>
            <!--END--Мои зказы-->







        </div>
    </nav>

    
    <button class="navbar-toggler" type="button">

        @if (User.Identity.IsAuthenticated)
        {
            <span class="nav-item text-success">@User.Identity.Name</span>
            

            @if (User.IsInRole(Constants.AdminRoleName))
            {
                <a class="nav-item" asp-area="Admin" asp-controller="Order" asp-action="Index">Панель администратора</a>
                <a class="nav-item" asp-area="" asp-controller="Account" asp-action="Logout">Выйти</a>
            }
            @if (User.IsInRole(Constants.UserRoleName))
            {
                <a class="nav-item" asp-area="" asp-controller="Account" asp-action="Logout">Выйти</a>
            }
        }
        else
        {
                <a class="nav-item" asp-area="" asp-controller="Account" asp-action="Autorization">ВХОД</a>
        }
    </button>



</header>