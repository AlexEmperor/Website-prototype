@model ProductViewModel
@{
    ViewData["Title"] = "Редактирование товара";
}

<div class="text-center text-uppercase text-success mb-5 mt-5">
    <h2 class="row-title">Редактирование товара</h2>
</div>

<form method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <div class="row justify-content-center mt-3">
        <div class="col-6 mb-3">
            <div class="text-danger fw-bold text-uppercase" asp-validation-summary="All"></div>


            <p>
                <label class="form-label" asp-for="Name"></label><br />
                <input class="form-control" asp-for="Name" value="@Model.Name" />
                <span asp-validation-for="Name"></span>
            </p>
            <p>
                <label class="form-label" asp-for="Cost"></label><br />
                <input type="number" class="form-control" asp-for="Cost" value="@Model.Cost" />
                <span asp-validation-for="Cost"></span>
            </p>
            <p>
                <label class="form-label" asp-for="Description"></label><br />
                <textarea class="form-control" asp-for="Description" value="@Model.Description"></textarea>
                <span asp-validation-for="Description"></span>
            </p>
            <p>
                <label class="form-label" asp-for="Article"></label><br />
                <textarea class="form-control" asp-for="Article"></textarea>
                <span asp-validation-for="Article"></span>
            </p>
            <p>
                <label class="form-label" asp-for="Barcode"></label><br />
                <textarea class="form-control" asp-for="Barcode"></textarea>
                <span asp-validation-for="Barcode"></span>
            </p>

@*             <p>
                <label>Фото</label>
                <input type="file" class="form-control" asp-for="PhotoFile" />
            </p> *@
            <p>
                <label asp-for="CategoryId">Категория</label>
                <select class="form-control"
                        asp-for="CategoryId"
                        asp-items="ViewBag.Categories">
                </select>
            </p>

            <p>
                <label asp-for="FurnitureOrderId">Заказ фурнитуры</label>
                <select class="form-control"
                        asp-for="FurnitureOrderId"
                        asp-items="ViewBag.FurnitureOrders">
                </select>
            </p>
            <p>
                <label class="form-label" asp-for="Storage_Ozon"></label><br />
                <textarea class="form-control" asp-for="Storage_Ozon"></textarea>
                <span asp-validation-for="Storage_Ozon"></span>
            </p>
            <p>
                <label>Склад FBS1 кол-во</label><br />
                <textarea class="form-control" asp-for="Storage_FBS1"></textarea>
                <span asp-validation-for="Storage_FBS1"></span>
            </p>
            <p>
                <label>Себестоимость</label><br />
                <textarea class="form-control" asp-for="Cost_price"></textarea>
                <span asp-validation-for="Cost_price"></span>
            </p>
            <p>
                <label>Затраты на Ozon</label><br />
                <textarea class="form-control" asp-for="Costs_Ozon"></textarea>
                <span asp-validation-for="Costs_Ozon"></span>
            </p>
            <p>
                <label>Маржа FBO1</label><br />
                <textarea class="form-control" asp-for="Margin_FBO1"></textarea>
                <span asp-validation-for="Margin_FBO1"></span>
            </p>
            <p>
                <label>Маржа FBS1</label><br />
                <textarea class="form-control" asp-for="Margin_FBS1"></textarea>
                <span asp-validation-for="Margin_FBS1"></span>
            </p>


        </div>
    </div>
    <div class="text-center m-3">
        <button class="btn btn-outline-success" type="submit">
            Обновить
        </button>
    </div>
</form>